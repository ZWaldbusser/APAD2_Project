# Browser -> Flask adapter. Blank uses the Vite /api proxy locally and same-origin
# requests in the built app. Do not point this at an upstream REST/gRPC service.
VITE_API_BASE_URL=

# Only the unconfirmed Overview aggregate may display an explicit sample.
# Users/MFA, Projects and Hardware always call real adapters.
VITE_USE_VISUALIZATION_MOCKS=false
# Set only when a real Overview aggregate endpoint/contract is supplied.
VITE_VISUALIZATION_URL=

# Flask (server-side only)
PORT=5050
FLASK_DEBUG=0

# Documented Projects API v1.4 production URL. Use the team's test endpoint where supplied.
PROJECTS_API_BASE_URL=https://projects-api.jollypond-07d76cbc.northcentralus.azurecontainerapps.io
PROJECTS_API_TIMEOUT_SECONDS=10

# Users service default from server/users/client.py; real account and MFA required.
USERS_GRPC_TARGET=apad-users-grpc.bluedesert-b9b6bdd4.westus.azurecontainerapps.io:443
USERS_API_TIMEOUT_SECONDS=30

# Obtain the current gRPC host and key from the Hardware team. No /api path.
# Keep credentials server-side; never use VITE_ for secrets or commit .env.
HARDWARE_API_BASE_URL_grpc=
HARDWARE_API_KEY=
HARDWARE_API_TEAM=front-end
HARDWARE_API_TIMEOUT_SECONDS=10
